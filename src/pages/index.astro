---
import Base from "../layouts/Base.astro";
import { loadWalks } from "../lib/walks.server";

const walks = await loadWalks();
---

<Base title="lost + found">
  <main>
    {walks.length ? (
      <ul class="walk-list">
        {walks.map((walk, index) => (
          <li>
            <a class="walk-link" href={`/walk/${walk.id}/`} aria-label={`Walk ${index + 1}, ${walk.date}, ${walk.duration}${walk.photos.length ? `, ${walk.photos.length} ${walk.photos.length === 1 ? "photo" : "photos"}` : ""}`}>
              <span class="walk-meta">
                <time datetime={walk.date}>{new Date(walk.date).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" })}</time>
                <span>{String(index + 1).padStart(2, "0")}</span>
              </span>
              <svg viewBox="0 0 64 64" aria-hidden="true">
                <path d={walk.thumbnailPath} fill="none" stroke="black" stroke-width="2.2" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="walk-footer">
                <span>{walk.duration}</span>
                {walk.photos.length > 0 && (
                  <span class="walk-photo-count">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="1.5" y="2" width="13" height="12" rx="1" />
                      <circle cx="5" cy="5.5" r="1" />
                      <path d="m2 12 4-4 2.5 2.5L10 9l4 4" />
                    </svg>
                    {walk.photos.length}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p>No walks yet.</p>
    )}
  </main>
</Base>
